PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/homecrew?schema=public"
# Optional: max DB connections. Use 1 with the local `npx prisma dev` database.
# DATABASE_POOL_MAX=1
# Optional: shadow DB for `prisma migrate dev` (the `npx prisma dev` one runs on the next port)
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
JWT_SECRET=long-random-string
ADMIN_EMAIL=admin@homecrew.ge
ADMIN_PASSWORD=change-me
